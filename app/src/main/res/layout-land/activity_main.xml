<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/green" android:fitsSystemWindows="true" android:orientation="vertical">
    <!-- Weights share the available space without fixed screen dimensions. -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/img_main_banner" />
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/banner_shade" />
        <!-- Keep the required 40sp title readable even on a small screen. -->
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="?android:attr/dialogPreferredPadding" android:text="@string/welcome_message" android:textColor="@color/white" android:textSize="40sp" />
        </ScrollView>
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <ImageButton android:id="@+id/button_facilities" android:onClick="facilitiesClicked" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/button_selector" android:contentDescription="@string/facilities" android:padding="?android:attr/dialogPreferredPadding" android:scaleType="fitCenter" android:src="@drawable/img_btn_facilities" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:labelFor="@id/button_facilities" android:text="@string/facilities" android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <ImageButton android:id="@+id/button_events" android:onClick="eventsClicked" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/button_selector" android:contentDescription="@string/events" android:padding="?android:attr/dialogPreferredPadding" android:scaleType="fitCenter" android:src="@drawable/img_btn_events" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:labelFor="@id/button_events" android:text="@string/events" android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <ImageButton android:id="@+id/button_clubs" android:onClick="clubsClicked" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/button_selector" android:contentDescription="@string/clubs" android:padding="?android:attr/dialogPreferredPadding" android:scaleType="fitCenter" android:src="@drawable/img_btn_clubs" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:labelFor="@id/button_clubs" android:text="@string/clubs" android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="@color/white" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
            <ImageButton android:id="@+id/button_support" android:onClick="supportClicked" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/button_selector" android:contentDescription="@string/support" android:padding="?android:attr/dialogPreferredPadding" android:scaleType="fitCenter" android:src="@drawable/img_btn_support" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:labelFor="@id/button_support" android:text="@string/support" android:textAppearance="?android:attr/textAppearanceSmall" android:textColor="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
